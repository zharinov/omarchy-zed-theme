#!/usr/bin/env bash
set -euo pipefail

if (( $# != 1 )); then
  echo "usage: scripts/prepare-test-inputs ABSOLUTE_DESTINATION" >&2
  exit 2
fi

destination="$1"
if [[ $destination != /* ]]; then
  echo "test-input destination must be absolute" >&2
  exit 2
fi
if [[ -e $destination && ! -d $destination ]]; then
  echo "test-input destination is not a directory: $destination" >&2
  exit 2
fi
if [[ -d $destination && -n $(find "$destination" -mindepth 1 -print -quit) ]]; then
  echo "refusing to replace non-empty test-input destination: $destination" >&2
  exit 2
fi

repository_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
mkdir -p "$destination/upstream" "$destination/external"
export GIT_TERMINAL_PROMPT=0

checkout_at() {
  local name="$1"
  local repository="$2"
  local commit="$3"
  local checkout="$4"
  shift 4

  mkdir "$checkout"
  git -C "$checkout" init --quiet
  git -C "$checkout" remote add origin "$repository"
  if (( $# > 0 )); then
    git -C "$checkout" sparse-checkout set --no-cone "$@"
  fi
  git -C "$checkout" fetch --quiet --depth=1 --filter=blob:none origin "$commit"
  git -C "$checkout" checkout --quiet --detach FETCH_HEAD

  local actual_commit
  actual_commit=$(git -C "$checkout" rev-parse HEAD)
  if [[ $actual_commit != "$commit" ]]; then
    echo "$name: expected $commit, checked out $actual_commit" >&2
    exit 1
  fi
}

while IFS=$'\t' read -r name repository commit; do
  [[ -z $name || $name == \#* ]] && continue

  case "$name" in
    omarchy)
      checkout_at "$name" "$repository" "$commit" "$destination/upstream/$name" \
        /bin/omarchy-theme-color '/themes/*/colors.toml' '/themes/*/light.mode'
      ;;
    zed)
      checkout_at "$name" "$repository" "$commit" "$destination/upstream/$name" \
        /crates/settings_content/src/theme.rs
      ;;
    *)
      echo "unsupported upstream test input: $name" >&2
      exit 1
      ;;
  esac
done < "$repository_root/tests/upstream-repositories.tsv"

while IFS=$'\t' read -r name repository commit palette_path; do
  [[ -z $name || $name == \#* ]] && continue

  if [[ $palette_path == */* ]]; then
    light_mode_path="${palette_path%/*}/light.mode"
  else
    light_mode_path="light.mode"
  fi
  checkout_at "$name" "$repository" "$commit" "$destination/external/$name" \
    "/$palette_path" "/$light_mode_path"

  if [[ ! -f $destination/external/$name/$palette_path ]]; then
    echo "$name: missing palette $palette_path" >&2
    exit 1
  fi
done < "$repository_root/tests/external-corpus.tsv"

printf 'OMARCHY_THEMES_DIR=%s\n' "$destination/upstream/omarchy/themes"
printf 'OMARCHY_ZED_THEME_COLOR_RESOLVER=%s\n' "$destination/upstream/omarchy/bin/omarchy-theme-color"
printf 'OMARCHY_ZED_THEME_EXTERNAL_CORPUS=%s\n' "$destination/external"
printf 'OMARCHY_ZED_THEME_ZED_SOURCE=%s\n' "$destination/upstream/zed"
